{
  "name": "nakiame/tinvest",
  "description": "T-Invest API integration",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^9.5",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Tinkoff\\Invest\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tinkoff\\Invest\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "check-style": "phpcs -p --standard=PSR12 src/ tests/",
    "fix-style": "phpcbf -p --standard=PSR12 src/ tests/"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
